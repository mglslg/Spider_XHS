# 小红书Cookie（必需）
# 获取方式：登录小红书后，F12打开控制台 -> Network -> 找到接口复制Cookie
XHS_COOKIE=

# 用户配置根目录（可选）
USER_PROFILE=

# Notion集成配置（可选）
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 代理配置（可选）
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=https://proxy:port

# Streamlit配置
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false